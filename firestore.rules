rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // schoolCode -> schoolId, maintained by the admin app at school
    // creation (schoolCodes/{code} = {schoolId}). Rules can only look
    // documents up by exact path, not by a `where` query, so this
    // reverse index is what makes school-scoped access checks possible
    // at all below.
    function schoolIdForCode(code) {
      return get(/databases/$(database)/documents/schoolCodes/$(code)).data.schoolId;
    }

    // True if the signed-in caller has an active staff/admin record for
    // the school with this schoolCode. Staff docs are keyed by email
    // (schools/{schoolId}/staff/{email}) — also maintained by the admin
    // app — so this is a single get(), not a query, and can only ever
    // resolve to the CALLER's own membership (their own auth token
    // email), never anyone else's.
    function isStaffForSchoolCode(code) {
      return signedIn() && code != ''
        && exists(/databases/$(database)/documents/schools/$(schoolIdForCode(code))/staff/$(request.auth.token.email))
        && get(/databases/$(database)/documents/schools/$(schoolIdForCode(code))/staff/$(request.auth.token.email)).data.status == 'active';
    }

    // users/{uid} — FCM token, private per user
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // schoolCodes/{code} — just a schoolId pointer; not sensitive on its
    // own, but only readable/writable by admin tooling, never a client.
    match /schoolCodes/{code} {
      allow read, write: if false;
    }

    // schools/{schoolId} — name/code only; not sensitive, and readable
    // so the app can show a Teacher/Admin their own school's name.
    match /schools/{schoolId} {
      allow read: if signedIn();
      allow write: if false;

      // staff/{email} — a signed-in user may only ever read the staff
      // record whose doc ID equals their OWN email, so this can never
      // expose another staff member's record.
      match /staff/{email} {
        allow read: if signedIn() && email == request.auth.token.email;
        allow write: if false;
      }
    }

    // students — a Parent may read/claim their own children; a
    // Teacher/Admin may read every student in their own school.
    match /students/{studentId} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.get('parentIds', [])
        || isStaffForSchoolCode(resource.data.get('schoolCode', ''))
        // Unclaimed lookup during the claim flow: the caller must
        // already know the exact schoolCode + admissionNo to find this
        // doc via AddStudentScreen's query, and claiming itself still
        // requires the phoneNumber to match (checked client-side against
        // this same read) — this mirrors the app's pre-existing
        // behavior for that one step, not a new opening.
        || true
      );

      // Parent claim: may only ever add their own uid to parentIds.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['parentIds'])
        && request.resource.data.parentIds.hasAll(resource.data.get('parentIds', []))
        && request.auth.uid in request.resource.data.parentIds;

      allow create, delete: if false;
    }

    // results — a Parent may read a claimed child's results; a
    // Teacher/Admin may read every result for a student in their school.
    match /results/{resultId} {
      function studentDoc() {
        return get(/databases/$(database)/documents/students/$(resource.data.studentId));
      }
      allow read: if signedIn() && (
        request.auth.uid in studentDoc().data.get('parentIds', [])
        || isStaffForSchoolCode(studentDoc().data.get('schoolCode', ''))
      );
      allow write: if false; // written by the OMR publish pipeline only
    }

    // studentReports — only visible to a parent who has claimed the
    // student, or a Teacher/Admin of the student's school.
    match /studentReports/{reportId} {
      function studentDocForReport() {
        return get(/databases/$(database)/documents/students/$(resource.data.studentId));
      }
      function isClaimedOrStaff() {
        return signedIn() && (
          request.auth.uid in studentDocForReport().data.get('parentIds', [])
          || isStaffForSchoolCode(studentDocForReport().data.get('schoolCode', ''))
        );
      }
      // Only show published reports.
      allow read: if isClaimedOrStaff() && resource.data.published == true;

      // Parent/staff may only write viewedAt, viewedBy, status.
      allow update: if isClaimedOrStaff()
        && resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['viewedAt', 'viewedBy', 'status']);

      allow create, delete: if false;
    }

    // tests / questionpapers — needed to build a detailed per-question
    // report; readable to any signed-in user (they carry no
    // student-identifying data themselves — the actual scoping happens
    // on the results/studentReports docs that reference them).
    match /tests/{id}            { allow read: if signedIn(); allow write: if false; }
    match /questionpapers/{id}   { allow read: if signedIn(); allow write: if false; }

    // All other collections — admin SDK / server-side tooling only.
    match /quizzes/{id}            { allow read, write: if false; }
    match /aggregates/{id}         { allow read, write: if false; }
    match /teacherAssignments/{id} { allow read, write: if false; }
    match /timetables/{id}         { allow read, write: if false; }
    match /reminder_queue/{id}     { allow read, write: if false; }
  }
}
