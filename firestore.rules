rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // users/{uid} — FCM token, private per user
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // students — parent can read to verify claim; can only append own uid
    match /students/{studentId} {
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['parentUids'])
        && request.resource.data.parentUids.hasAll(resource.data.parentUids)
        && request.auth.uid in request.resource.data.parentUids;
      allow create, delete: if false;
    }

    // studentReports — only visible to a parent who has claimed the student
    match /studentReports/{reportId} {
      function isClaimed() {
        return signedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/students/$(resource.data.studentId))
               .data.parentUids;
      }
      // Only show published reports to parents
      allow read: if isClaimed() && resource.data.published == true;

      // Parent may only write viewedAt, viewedBy, status
      allow update: if isClaimed()
        && resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['viewedAt', 'viewedBy', 'status']);

      allow create, delete: if false;
    }

    // All other collections — admin SDK only
    match /results/{id}            { allow read, write: if false; }
    match /questionpapers/{id}     { allow read, write: if false; }
    match /quizzes/{id}            { allow read, write: if false; }
    match /tests/{id}              { allow read, write: if false; }
    match /schools/{id}            { allow read, write: if false; }
    match /aggregates/{id}         { allow read, write: if false; }
    match /teacherAssignments/{id} { allow read, write: if false; }
    match /timetables/{id}         { allow read, write: if false; }
    match /reminder_queue/{id}     { allow read, write: if false; }
  }
}
